# ============================================================
# AI Resume Analyzer Pro - Environment Configuration
# ============================================================

# Groq API Key (Required for live LLM inferences)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# MySQL Configuration (Optional)
# If left blank, the application automatically falls back to local SQLite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=resume_db

# Alternative: Direct Database Connection URL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/resume_db
